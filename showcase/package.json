{
  "name": "skpods-showcase",
  "private": true,
  "version": "0.1.0",
  "description": "SKPods showcase apps: Solid pods that feel good to use",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -b --noEmit false 2>&1 || true",
    "test": "npm run test -w @skpods/solid-web",
    "test:integration": "npm run test:integration -w @skpods/solid-web",
    "dev:hello": "npm run dev -w @skpods/hello-pod"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
